# Required for answer generation, vision, and embeddings
GOOGLE_API_KEY=

# Pipeline backend switches - see rag/config.py for full explanation
EMBEDDING_BACKEND=gemini     # gemini | local (local = sentence-transformers, no key needed)
TABLE_PARSER_BACKEND=api     # api | local (local = heuristic formatting, no LLM call)

# Optional: Override default models if needed due to quota/latency requirements
# Default: models/gemini-3.1-flash-lite
# Uncomment to use models/gemini-3.7-flash (Note: RPD is 20)
# GEMINI_TEXT_MODEL=models/gemini-3.7-flash
# GEMINI_VISION_MODEL=models/gemini-3.7-flash

# Retrieval tuning
TOP_K=5
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150

PORT=5000
